generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int                 @id @default(autoincrement())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  email           String              @unique
  name            String?
  uclaId          String?             @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  sessions        Session[]
  tokens          VerificationToken[]
  student         Student?
  researcher      Researcher?
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       VerificationType
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id])
}

enum VerificationType {
  SIGNUP
  LOGIN
}

model Student {
  userId       Int       @id
  user         User      @relation(fields: [userId], references: [id])
  year         String    
  major        String
  description  String?
  applications Application[]
}

model Researcher {
  userId       Int        @id
  user         User       @relation(fields: [userId], references: [id])
  verifyStatus verification
  department   string
  posts        Post[]
}

enum verification {
  VERIFIED
  PENDING
  UNVERIFIED
}

model Admin {
  email            String     @unique
  passwordHash     String
}

model Post {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  title       String
  body        String
  researcherId Int
  researcher   Researcher   @relation(fields: [researcherId], references: [userId])
  questions   Question[]
  tags        String[]
  applications Application[]
}

model Application {
  id         Int               @id @default(autoincrement())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  status     ApplicationStatus
  studentId  Int
  postId     Int
  student    Student           @relation(fields: [studentId], references: [userId])
  post       Post              @relation(fields: [postId], references: [id])
  answers    Answer[]
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Question {
  id        Int           @id @default(autoincrement())
  postId    Int
  type      QuestionType  
  body      Json         

  post      Post          @relation(fields: [postId], references: [id])
  answers   Answer[]
}

model Answer {
  id            Int           @id @default(autoincrement())
  type          QuestionType
  questionId    Int
  applicationId Int
  body          Json

  question      Question      @relation(fields: [questionId], references: [id])
  application   Application   @relation(fields: [applicationId], references: [id])
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  CHECKBOX
}
