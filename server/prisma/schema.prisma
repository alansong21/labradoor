generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int                 @id @default(autoincrement())
  createdAt       DateTime            @default(now())
  email           String              @unique
  name            String?
  emailVerifiedAt DateTime?
  passwordHash    String
  uclaId          String?             @unique
  updatedAt       DateTime            @updatedAt
  researcher      Researcher?
  sessions        Session[]
  student         Student?
  tokens          VerificationToken[]
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id         Int              @id @default(autoincrement())
  userId     Int
  type       VerificationType
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id])
}

model Student {
  userId       Int           @id
  year         String
  major        String
  description  String?
  applications Application[]
  user         User          @relation(fields: [userId], references: [id])
}

model Researcher {
  userId       Int          @id
  verifyStatus verification
  department   String
  posts        Post[]
  user         User         @relation(fields: [userId], references: [id])
}

model Admin {
  email        String @unique
  passwordHash String
}

model Post {
  id           Int           @id @default(autoincrement())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  title        String
  body         String
  researcherId Int
  tags         String[]
  applications Application[]
  researcher   Researcher    @relation(fields: [researcherId], references: [userId])
  questions    Question[]
}

model Application {
  id        Int               @id @default(autoincrement())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  status    ApplicationStatus
  studentId Int
  postId    Int
  answers   Answer[]
  post      Post              @relation(fields: [postId], references: [id])
  student   Student           @relation(fields: [studentId], references: [userId])
}

model Question {
  id      Int          @id @default(autoincrement())
  postId  Int
  type    QuestionType
  body    Json
  answers Answer[]
  post    Post         @relation(fields: [postId], references: [id])
}

model Answer {
  id            Int          @id @default(autoincrement())
  type          QuestionType
  questionId    Int
  applicationId Int
  body          Json
  application   Application  @relation(fields: [applicationId], references: [id])
  question      Question     @relation(fields: [questionId], references: [id])
}

enum VerificationType {
  SIGNUP
  LOGIN
}

enum verification {
  VERIFIED
  PENDING
  UNVERIFIED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  CHECKBOX
}
